{
  "name": "@mwaeckerlin/wordpress-php-fpm",
  "version": "1.0.2",
  "scripts": {
    "build": "docker compose build",
    "start": "docker compose up --build --force-recreate --remove-orphans",
    "start:daemon": "docker compose up -d --build --force-recreate --remove-orphans",
    "start:dev": "docker compose up --build --force-recreate --remove-orphans",
    "stop": "docker compose down",
    "deploy": "docker compose push",
    "test": "npm run test:docs && npm run test:image && npm run test:config",
    "test:docs": "bash tests/docs-contract.sh",
    "test:image": "npm run build && bash tests/image-contract.sh mwaeckerlin/wordpress-php-fpm",
    "test:config": "bash tests/config-contract.sh mwaeckerlin/wordpress-php-fpm"
  }
}
